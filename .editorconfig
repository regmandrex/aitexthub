# Editor-agnostic guard against the recurring text corruption (Hangul, em-dashes,
# accented characters getting re-saved through Windows-1252). charset=utf-8 tells
# any EditorConfig-aware editor to always read/write these files as UTF-8.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false

{
    "files.autoSave": "afterDelay",
    // Pin UTF-8 and never auto-guess. Without this, VS Code could guess a
    // Korean/accented file as Windows-1252 and autosave would silently re-save
    // it in that codepage — baking in mojibake. This is the root cause of the
    // recurring Hangul/em-dash corruption on this repo.
    "files.encoding": "utf8",
    "files.autoGuessEncoding": false,
    "[typescript]": { "files.encoding": "utf8" },
    "[typescriptreact]": { "files.encoding": "utf8" },
    "[json]": { "files.encoding": "utf8" }
}
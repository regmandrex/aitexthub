# Enforce consistent, UTF-8-safe handling of source files.
# This prevents the mojibake/?-corruption that commit b128b00 introduced when
# files containing Hangul, em-dashes, and accented characters were re-saved
# through a non-UTF-8 codepage (Windows-1252).

# Treat all source/text as text with normalized LF in the repo.
*.ts    text eol=lf working-tree-encoding=UTF-8
*.tsx   text eol=lf working-tree-encoding=UTF-8
*.js    text eol=lf working-tree-encoding=UTF-8
*.jsx   text eol=lf working-tree-encoding=UTF-8
*.mjs   text eol=lf working-tree-encoding=UTF-8
*.json  text eol=lf working-tree-encoding=UTF-8
*.css   text eol=lf working-tree-encoding=UTF-8
*.md    text eol=lf working-tree-encoding=UTF-8
*.mdx   text eol=lf working-tree-encoding=UTF-8
*.html  text eol=lf working-tree-encoding=UTF-8
*.txt   text eol=lf working-tree-encoding=UTF-8
*.xml   text eol=lf working-tree-encoding=UTF-8

# Binary assets — never touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary

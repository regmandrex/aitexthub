{
  "name": "gptcleanuptools",
  "version": "1.0.0",
  "private": true,
  "browserslist": [
    "Chrome >= 111",
    "Firefox >= 111",
    "Safari >= 16.4",
    "Edge >= 111"
  ],
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev --turbo",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=16384 next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit-tools": "node scripts/audit-tool-pages.mjs",
    "check-words": "node scripts/audit-tool-pages.mjs",
    "check-encoding": "node scripts/check-encoding.mjs",
    "prebuild": "node scripts/check-encoding.mjs",
    "postinstall": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.20.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.11",
    "diff": "^9.0.0",
    "exifr": "^7.1.3",
    "figlet": "^1.11.0",
    "js-yaml": "^4.1.1",
    "jsqr": "^1.4.0",
    "marked": "^18.0.1",
    "next": "^16.2.6",
    "next-seo": "^6.1.0",
    "otpauth": "^9.5.0",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "replicate": "^1.4.0",
    "resend": "^6.12.3",
    "sql-formatter": "^15.7.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/figlet": "^1.7.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
